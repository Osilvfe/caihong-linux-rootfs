#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Copyright (c) 2026 Osilvfe <osilvfe@gmail.com>
set -Eeuo pipefail
CDPATH=

function_name=ffs.adb
mount_point=/dev/usb-ffs/adb
usb_vendor_id=${CAIHONG_ADB_USB_VID:-}
usb_product_id=${CAIHONG_ADB_USB_PID:-}
usb_ids_file=${CAIHONG_ADB_USB_IDS_FILE:-/etc/caihong-adbd-usb-ids}
compatible_file=${CAIHONG_ADB_COMPATIBLE_FILE:-/proc/device-tree/compatible}
serial_file=${CAIHONG_ADB_SERIAL_FILE:-/etc/caihong-adbd-serial}
cmdline_file=${CAIHONG_ADB_CMDLINE_FILE:-/proc/cmdline}
hostname_file=${CAIHONG_ADB_HOSTNAME_FILE:-/proc/sys/kernel/hostname}
configfs=/sys/kernel/config
gadget_dir=$configfs/usb_gadget/caihong
function_dir=$gadget_dir/functions/$function_name
config_dir=$gadget_dir/configs/c.1
ready_file=$function_dir/ready
adbd_user=${ADBD_USER:-root}

adbd_uid=$(id -u "$adbd_user") || {
	echo "unknown ADB runtime user: $adbd_user" >&2
	exit 1
}
adbd_gid=$(id -g "$adbd_user")

detect_serial()
{
	serial=
	if [[ -r $cmdline_file ]]; then
		local cmdline
		cmdline=$(<"$cmdline_file")
		for serial_key in oplusboot.serialno androidboot.serialno; do
			if [[ $cmdline =~ (^|[[:space:]])${serial_key}=([^[:space:]]+) ]]; then
				serial=${BASH_REMATCH[2]}
				break
			fi
		done
	fi
	if [[ -z $serial && -r $serial_file ]]; then
		serial=$(head -n 1 "$serial_file")
	fi
	if [[ -z $serial && -r $hostname_file ]]; then
		serial=$(<"$hostname_file")
	fi
	[[ $serial =~ ^[[:graph:]]{1,64}$ ]] || {
		echo "invalid ADB serial number: $serial" >&2
		return 1
	}
}

validate_usb_ids()
{
	for usb_id in "$usb_vendor_id" "$usb_product_id"; do
		[[ $usb_id =~ ^0x[[:xdigit:]]{4}$ ]] || {
			echo "invalid USB vendor/product ID: $usb_id" >&2
			return 1
		}
	done
}

detect_usb_ids()
{
	if [[ -n $usb_vendor_id || -n $usb_product_id ]]; then
		[[ -n $usb_vendor_id && -n $usb_product_id ]] || {
			echo 'set both CAIHONG_ADB_USB_VID and CAIHONG_ADB_USB_PID' >&2
			return 1
		}
	else
		usb_vendor_id=0x18d1
		usb_product_id=0x4ee7
		if [[ -r $usb_ids_file && -r $compatible_file ]]; then
			local compatible board vid pid extra
			while IFS= read -r -d '' compatible; do
				while read -r board vid pid extra; do
					[[ -n $board && $board != \#* ]] || continue
					if [[ $board == "$compatible" ]]; then
						[[ -z $extra && -n $vid && -n $pid ]] || {
							echo "invalid USB ID entry for $compatible" >&2
							return 1
						}
						usb_vendor_id=$vid
						usb_product_id=$pid
						validate_usb_ids
						return
					fi
				done < "$usb_ids_file"
			done < "$compatible_file"
		fi
	fi
	validate_usb_ids
}

ensure_configfs()
{
	if [[ ! -d $configfs/usb_gadget ]]; then
		mkdir -p -- "$configfs"
		mountpoint -q "$configfs" || mount -t configfs none "$configfs"
	fi
	[[ -d $configfs/usb_gadget ]] || {
		echo "USB gadget configfs is unavailable" >&2
		return 1
	}
}

configure()
{
	ensure_configfs
	teardown 2>/dev/null || true
	local attempts=0
	while [[ -e $gadget_dir ]]; do
		((++attempts < 50)) || {
			echo "timed out removing the previous USB gadget" >&2
			return 1
		}
		sleep 0.1
	done
	detect_usb_ids
	mkdir -p -- "$gadget_dir" "$config_dir" "$function_dir" "$mount_point"
	mkdir -- "$gadget_dir/strings/0x409" "$config_dir/strings/0x409"
	printf '%s\n' "$usb_vendor_id" > "$gadget_dir/idVendor"
	printf '%s\n' "$usb_product_id" > "$gadget_dir/idProduct"
	printf '0x0200\n' > "$gadget_dir/bcdUSB"
	printf '0x0100\n' > "$gadget_dir/bcdDevice"
	printf 'Caihong\n' > "$gadget_dir/strings/0x409/manufacturer"
	printf 'Caihong ADB (%s)\n' "$usb_product_id" > "$gadget_dir/strings/0x409/product"
	printf 'ADB\n' > "$config_dir/strings/0x409/configuration"
	printf '250\n' > "$config_dir/MaxPower"
	detect_serial
	printf '%s\n' "$serial" > "$gadget_dir/strings/0x409/serialnumber"
	(cd -- "$config_dir" && ln -s -- "../../functions/$function_name" "$function_name")
	mount -t functionfs adb "$mount_point" -o "uid=$adbd_uid,gid=$adbd_gid"
}

bind()
{
	local attempts=0
	until [[ $(<"$ready_file") == 1 ]]; do
		((++attempts < 100)) || {
			echo "adbd did not initialize FunctionFS" >&2
			return 1
		}
		sleep 0.1
	done
	local udc
	udc=$(find /sys/class/udc -mindepth 1 -maxdepth 1 -printf '%f\n' | head -n 1)
	[[ -n $udc ]] || {
		echo "no USB device controller is available" >&2
		return 1
	}
	printf '%s\n' "$udc" > "$gadget_dir/UDC"
}

teardown()
{
	if [[ -e $gadget_dir/UDC ]]; then
		printf '\n' > "$gadget_dir/UDC" 2>/dev/null || true
	fi
	rm -f -- "$config_dir/$function_name"
	umount "$mount_point" 2>/dev/null || true
	rmdir --ignore-fail-on-non-empty \
		"$config_dir/strings/0x409" "$config_dir" 2>/dev/null || true
	rmdir "$function_dir" 2>/dev/null || true
	rmdir --ignore-fail-on-non-empty \
		"$gadget_dir/strings/0x409" "$gadget_dir" 2>/dev/null || true
	rmdir "$mount_point" 2>/dev/null || true
	[[ ! -e $gadget_dir ]] || {
		echo "failed to remove USB gadget" >&2
		return 1
	}
}

case ${1:-} in
	setup) configure ;;
	bind) bind ;;
	teardown) teardown ;;
	ids)
		detect_usb_ids
		detect_serial
		printf '%s %s %s\n' "$usb_vendor_id" "$usb_product_id" "$serial"
		;;
	*)
		echo "usage: $0 {setup|bind|teardown|ids}" >&2
		exit 2
		;;
esac
