set -eu

if [ "$(id -u)" -ne 0 ]; then
	echo "caihong-fix-kwin-brightness must be run as root" >&2
	exit 1
fi

config=/home/alarm/.config/kwinoutputconfig.json
state_dir=/var/lib/caihong
marker=$state_dir/kwin-brightness-v1

# KWin stores eleven lux thresholds for 0%, 10%, ..., 100% brightness.
# These thresholds are a reduced form of the stock OPlus curve from
# odm/overlay/OPlusFrameworksResTarget.apk (1..40000 lux, 6..800 nits).
curve='[0.0, 8.96, 30.8, 71.4, 512.0, 952.5, 1304.0, 1651.5, 1867.3333333333333, 7030.0, 40000.0]'

# KWin creates this file only after the first Plasma session has started.  Seed
# a minimal connector-only configuration before the display manager so automatic
# brightness is active in that first session.  KWin fills in the mode, scale and
# generated output UUID when it loads the file.
if [ ! -f "$config" ]; then
	install -d -o alarm -g alarm -m 0700 "${config%/*}"
	cat > "$config" <<'EOF'
[
    {
        "data": [
            {
                "connectorName": "DSI-1"
            }
        ],
        "name": "outputs"
    },
    {
        "data": [
            {
                "lidClosed": false,
                "outputs": [
                    {
                        "enabled": true,
                        "outputIndex": 0,
                        "position": {
                            "x": 0,
                            "y": 0
                        },
                        "priority": 1,
                        "replicationSource": ""
                    }
                ]
            }
        ],
        "name": "setups"
    }
]
EOF
	chown alarm:alarm "$config"
	chmod 0644 "$config"
fi

mkdir -p "$state_dir"
backup=$state_dir/kwinoutputconfig.json.before-brightness-v1
if [ ! -e "$backup" ]; then
	cp -a -- "$config" "$backup"
fi

python3 - "$config" "$marker" "$curve" <<'PY'
import json
import os
import stat
import sys
import tempfile

config, marker, curve_text = sys.argv[1:]
curve = json.loads(curve_text)

with open(config, "r", encoding="utf-8") as stream:
    document = json.load(stream)

changed = False
found = False
for section in document:
    if section.get("name") != "outputs":
        continue
    for output in section.get("data", []):
        if output.get("connectorName") != "DSI-1":
            continue
        found = True
        existing = output.get("autoBrightnessCurve")
        # A previous migration may have raced with KWin while it was exiting.
        # Reapply only when the persisted curve is still the old narrow model;
        # leave a genuinely broad user-learned curve intact on later boots.
        if isinstance(existing, list) and len(existing) == len(curve):
            try:
                if float(existing[-1]) >= 10000.0:
                    continue
            except (TypeError, ValueError):
                pass
        output["autoBrightnessCurve"] = curve
        output["automaticBrightness"] = True
        changed = True

if not found:
    print("DSI-1 was not present; leaving KWin configuration unchanged", file=sys.stderr)
    raise SystemExit(0)
if not changed:
    print("Stock-derived KWin DSI-1 automatic brightness curve is already configured")
    raise SystemExit(0)

mode = stat.S_IMODE(os.stat(config).st_mode)
uid = os.stat(config).st_uid
gid = os.stat(config).st_gid
directory = os.path.dirname(config)
fd, temporary = tempfile.mkstemp(prefix=".kwinoutputconfig.", dir=directory, text=True)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as stream:
        json.dump(document, stream, indent=4)
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(temporary, mode)
    os.chown(temporary, uid, gid)
    os.replace(temporary, config)
except BaseException:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
    raise

with open(marker, "w", encoding="utf-8") as stream:
    stream.write("source=OPlusFrameworksResTarget.apk\n")
    stream.write("curve=0,8.96,30.8,71.4,512,952.5,1304,1651.5,1867.3333333333333,7030,40000\n")
print("Applied stock-derived KWin DSI-1 automatic brightness curve")
PY
