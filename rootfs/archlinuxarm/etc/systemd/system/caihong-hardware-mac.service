[Unit]
Description=Load Caihong WLAN and Bluetooth hardware addresses
Wants=bluetooth.service
After=systemd-udevd.service systemd-modules-load.service bluetooth.service
Before=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/caihong-hardware-mac
TimeoutStartSec=120
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
