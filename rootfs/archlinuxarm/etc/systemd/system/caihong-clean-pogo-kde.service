[Unit]
Description=Remove unsupported Caihong Pogo keyboard backlight actions
After=display-manager.service
Before=graphical.target
ConditionPathExists=/home/alarm/.config/kglobalshortcutsrc

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/caihong-clean-pogo-kde
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
