# Stable source branches followed by the release workflow. Every build writes
# the resolved commit IDs into its release manifest.
LINUX_REPOSITORY=https://github.com/Osilvfe/linux.git
LINUX_REF=caihong-v7.3
LIBCAMERA_REPOSITORY=https://github.com/Osilvfe/libcamera.git
LIBCAMERA_REF=caihong-camera
PLASMA_CAMERA_REPOSITORY=https://github.com/Osilvfe/plasma-camera.git
PLASMA_CAMERA_REF=caihong-camera
TOOLBOX_REPOSITORY=https://github.com/Osilvfe/caihong-toolbox.git
TOOLBOX_REF=main
QCOM_VA_REPOSITORY=https://github.com/radxa-pkg/qcom-va-driver.git
# 0980a1d installs qcom_drv_video.so; v1.1.1 still installs v4l2_drv_video.so.
QCOM_VA_REF=0980a1decf26d34c9aa71cd0a4a0d25703a7a17f
QBOOTCTL_REPOSITORY=https://github.com/linux-msm/qbootctl.git
QBOOTCTL_REF=main
# The rootfs applies packaging/power-profiles-daemon-caihong/0001-qcom-cpufreq.patch.
POWER_PROFILES_DAEMON_REPOSITORY=https://gitlab.freedesktop.org/upower/power-profiles-daemon.git
POWER_PROFILES_DAEMON_REF=1a151ccd8bb42c050960f65ca3dee31effde6b36
MKBOOTIMG_REPOSITORY=https://android.googlesource.com/platform/system/tools/mkbootimg
MKBOOTIMG_REF=main
