#
# Follow Armada's stable channel. The packaging script records the resolved
# content digest in every image so a build remains auditable without freezing
# Armada updates in this repository.
: "${ARMADA_IMAGE:=ghcr.io/armada-os/armada:stable}"
export ARMADA_IMAGE
