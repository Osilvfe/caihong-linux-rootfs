+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 3 as published by
+ * the Free Software Foundation.
+ *
+ */
+
+/*
+ * CPU driver for the Qualcomm cpufreq-hw scaling driver.
+ *
+ * Qualcomm SoCs describe their frequency domains in firmware and expose them
+ * through qcom-cpufreq-hw. Unlike amd-pstate and intel-pstate there is no
+ * energy_performance_preference (EPP) interface, and there is no ACPI
+ * platform_profile on these ARM machines. The only profile knobs available
+ * from userspace are:
+ *
+ *  - the global cpufreq boost switch, which gates the turbo OPPs that the
+ *    firmware LUT marks as boost frequencies (on SM8650 that is the prime
+ *    core's 3.30 GHz bin), and
+ *  - a per-policy scaling_max_freq cap, which lets the energy-aware scheduler
+ *    place work on the smaller cores instead of the big ones.
+ *
+ * The mappings therefore are:
+ *
+ *  - power-saver: boost off, cap every policy at the highest frequency that
+ *    is at most 70% of its non-boost maximum, and cap the GPU devfreq device
+ *    at 50% of its maximum clock.
+ *  - balanced: boost off, full non-boost range and full GPU range. This is
+ *    the hardware's sustainable state and matches the default schedutil
+ *    behaviour.
+ *  - performance: boost on, full range including the boost OPPs.
+ *
+ * Thermal throttling is left to the kernel: qcom-cpufreq-hw enforces LMh
+ * limits in hardware and the cpufreq cooling devices clamp the policies
+ * through PM QoS, so the caps written here never override a thermal limit.
+ * The GPU cap only lowers devfreq's scaling_max_freq; the GPU cooling device
+ * can still clamp it further.
+ *
+ * The two power-saver percentages can be overridden from the service
+ * environment with PPD_QCOM_CPU_POWER_SAVER_PERCENT (default 70) and
+ * PPD_QCOM_GPU_POWER_SAVER_PERCENT (default 50). Values outside 10-100 are
+ * ignored with a warning.
+ */
+
+#define G_LOG_DOMAIN "CpuDriver"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <glib/gstdio.h>
+#include <upower.h>
+
+#include "ppd-utils.h"
+#include "ppd-driver-qcom-cpufreq.h"
+
+#define CPUFREQ_POLICY_DIR "/sys/devices/system/cpu/cpufreq/"
+#define CPUFREQ_BOOST_PATH "/sys/devices/system/cpu/cpufreq/boost"
+#define DEVFREQ_DIR "/sys/class/devfreq"
+#define QCOM_SCALING_DRIVER "qcom-cpufreq-hw"
+
+/* Highest frequency usable in power-saver, as a percentage of the
+ * non-boost maximum of each policy.  Overridable through the systemd unit
+ * environment, see the packaging README. */
+#define POWER_SAVER_PERCENT 70
+
+/* Highest GPU clock in power-saver, as a percentage of the GPU maximum. */
+#define GPU_POWER_SAVER_PERCENT 50
+
+/* Refuse nonsensical caps from the environment: below 10% the device is not
+ * usable, and above 100% a cap would be a no-op. */
+#define MIN_POWER_SAVER_PERCENT 10
+#define MAX_POWER_SAVER_PERCENT 100
+
+typedef struct
+{
+  char  *path;
+  guint  min_freq;
+  guint  max_freq;
+  guint  boost_freq;
+  guint  power_saver_max_freq;
+} PpdQcomPolicy;
+
+typedef struct
+{
+  char  *path;
+  guint  max_freq;
+  guint  power_saver_max_freq;
+} PpdQcomDevfreq;
+
+struct _PpdDriverQcomCpufreq
+{
+  PpdDriverCpu    parent_instance;
+
+  PpdProfile      activated_profile;
+  char           *boost_path;
+  GArray         *policies;
+  PpdQcomDevfreq  gpu;
+  gboolean        has_gpu;
+  guint           cpu_power_saver_percent;
+  guint           gpu_power_saver_percent;
+};
+
+G_DEFINE_TYPE (PpdDriverQcomCpufreq, ppd_driver_qcom_cpufreq, PPD_TYPE_DRIVER_CPU)
+
+static GObject*
+ppd_driver_qcom_cpufreq_constructor (GType                  type,
+                                     guint                  n_construct_params,
+                                     GObjectConstructParam *construct_params)
+{
+  GObject *object;
+
+  object = G_OBJECT_CLASS (ppd_driver_qcom_cpufreq_parent_class)->constructor (type,
+                                                                               n_construct_params,
+                                                                               construct_params);
+  g_object_set (object,
+                "driver-name", "qcom_cpufreq",
+                "profiles", PPD_PROFILE_PERFORMANCE | PPD_PROFILE_BALANCED | PPD_PROFILE_POWER_SAVER,
+                NULL);
+
+  return object;
+}
+
+static void
+policy_clear (PpdQcomPolicy *policy)
+{
+  g_clear_pointer (&policy->path, g_free);
+}
+
+static gboolean
+read_freq_file (const char *path,
+                guint      *min_freq,
+                guint      *max_freq)
+{
+  g_autofree char *contents = NULL;
+  g_autoptr(GError) error = NULL;
+  g_auto(GStrv) freqs = NULL;
+  guint min = G_MAXUINT;
+  guint max = 0;
+  guint i;
+
+  if (!g_file_get_contents (path, &contents, NULL, &error)) {
+    g_debug ("Failed to read %s: %s", path, error->message);
+    return FALSE;
+  }
+
+  freqs = g_strsplit_set (contents, " \t\n", -1);
+  for (i = 0; freqs[i] != NULL; i++) {
+    guint64 freq;
+
+    if (*freqs[i] == '\0')
+      continue;
+
+    freq = g_ascii_strtoull (freqs[i], NULL, 10);
+    if (freq == 0 || freq > G_MAXUINT)
+      continue;
+
+    min = MIN (min, (guint) freq);
+    max = MAX (max, (guint) freq);
+  }
+
+  if (max == 0)
+    return FALSE;
+
+  if (min_freq != NULL)
+    *min_freq = min;
+  if (max_freq != NULL)
+    *max_freq = max;
+
+  return TRUE;
+}
+
+static guint
+capped_max_freq (const char *available_freqs_path,
+                 guint       max_freq,
+                 guint       percent)
+{
+  g_autofree char *contents = NULL;
+  g_autoptr(GError) error = NULL;
+  g_auto(GStrv) freqs = NULL;
+  guint64 limit = (guint64) max_freq * percent / 100;
+  guint best = 0;
+  guint i;
+
+  if (!g_file_get_contents (available_freqs_path, &contents, NULL, &error)) {
+    g_debug ("Failed to read %s: %s", available_freqs_path, error->message);
+    return limit;
+  }
+
+  freqs = g_strsplit_set (contents, " \t\n", -1);
+  for (i = 0; freqs[i] != NULL; i++) {
+    guint64 freq;
+
+    if (*freqs[i] == '\0')
+      continue;
+
+    freq = g_ascii_strtoull (freqs[i], NULL, 10);
+    if (freq > limit || freq > G_MAXUINT)
+      continue;
+
+    best = MAX (best, (guint) freq);
+  }
+
+  return best != 0 ? best : (guint) limit;
+}
+
+static guint
+power_saver_percent (const char *env_name,
+                     guint       fallback)
+{
+  const char *value = g_getenv (env_name);
+  guint64 parsed;
+
+  if (value == NULL || *value == '\0')
+    return fallback;
+
+  parsed = g_ascii_strtoull (value, NULL, 10);
+  if (parsed < MIN_POWER_SAVER_PERCENT || parsed > MAX_POWER_SAVER_PERCENT) {
+    g_warning ("Ignoring invalid %s=%s, keeping %u%%",
+               env_name, value, fallback);
+    return fallback;
+  }
+
+  return (guint) parsed;
+}
+
+static gboolean
+policy_init (const char     *policy_dir,
+             PpdQcomPolicy  *policy,
+             guint           power_saver_percent_value)
+{
+  g_autofree char *scaling_driver_path = NULL;
+  g_autofree char *available_freqs_path = NULL;
+  g_autofree char *boost_freqs_path = NULL;
+  g_autofree char *scaling_max_path = NULL;
+  g_autofree char *driver = NULL;
+  g_autoptr(GError) error = NULL;
+  int fd;
+
+  scaling_driver_path = g_build_filename (policy_dir, "scaling_driver", NULL);
+  if (!g_file_get_contents (scaling_driver_path, &driver, NULL, &error)) {
+    g_debug ("Failed to read %s: %s", scaling_driver_path, error->message);
+    return FALSE;
+  }
+
+  if (!g_str_equal (g_strstrip (driver), QCOM_SCALING_DRIVER)) {
+    g_debug ("%s uses scaling driver %s, which this driver does not handle",
+             policy_dir, g_strstrip (driver));
+    return FALSE;
+  }
+
+  available_freqs_path = g_build_filename (policy_dir, "scaling_available_frequencies", NULL);
+  if (!read_freq_file (available_freqs_path, &policy->min_freq, &policy->max_freq)) {
+    g_debug ("%s has no usable frequency table, skipping", policy_dir);
+    return FALSE;
+  }
+
+  boost_freqs_path = g_build_filename (policy_dir, "scaling_boost_frequencies", NULL);
+  if (!read_freq_file (boost_freqs_path, NULL, &policy->boost_freq))
+    policy->boost_freq = 0;
+
+  scaling_max_path = g_build_filename (policy_dir, "scaling_max_freq", NULL);
+  fd = g_open (scaling_max_path, O_WRONLY);
+  if (fd == -1) {
+    g_debug ("Could not open %s for writing: %s",
+             scaling_max_path, g_strerror (errno));
+    return FALSE;
+  }
+  g_close (fd, NULL);
+
+  policy->path = g_strdup (policy_dir);
+  policy->power_saver_max_freq = capped_max_freq (available_freqs_path,
+                                                   policy->max_freq,
+                                                   power_saver_percent_value);
+  policy->power_saver_max_freq = MAX (policy->power_saver_max_freq,
+                                      policy->min_freq);
+
+  g_debug ("Found policy %s: min %u, max %u, boost %u, power-saver max %u",
+           policy->path, policy->min_freq, policy->max_freq,
+           policy->boost_freq, policy->power_saver_max_freq);
+  return TRUE;
+}
+
+static gboolean
+devfreq_init (const char     *devfreq_dir,
+              PpdQcomDevfreq *devfreq,
+              guint           power_saver_percent_value)
+{
+  g_autofree char *available_freqs_path = NULL;
+  g_autofree char *max_freq_path = NULL;
+  guint min_freq;
+  int fd;
+
+  available_freqs_path = g_build_filename (devfreq_dir,
+                                           "available_frequencies", NULL);
+  if (!read_freq_file (available_freqs_path, &min_freq, &devfreq->max_freq)) {
+    g_debug ("%s has no usable frequency table, skipping", devfreq_dir);
+    return FALSE;
+  }
+
+  max_freq_path = g_build_filename (devfreq_dir, "max_freq", NULL);
+  fd = g_open (max_freq_path, O_WRONLY);
+  if (fd == -1) {
+    g_debug ("Could not open %s for writing: %s",
+             max_freq_path, g_strerror (errno));
+    return FALSE;
+  }
+  g_close (fd, NULL);
+
+  devfreq->path = g_strdup (devfreq_dir);
+  devfreq->power_saver_max_freq = capped_max_freq (available_freqs_path,
+                                                   devfreq->max_freq,
+                                                   power_saver_percent_value);
+  devfreq->power_saver_max_freq = MAX (devfreq->power_saver_max_freq, min_freq);
+
+  g_debug ("Found GPU devfreq device %s: max %u, power-saver max %u",
+           devfreq->path, devfreq->max_freq, devfreq->power_saver_max_freq);
+  return TRUE;
+}
+
+static void
+gpu_probe (PpdDriverQcomCpufreq *self)
+{
+  g_autofree char *devfreq_dir = NULL;
+  g_autoptr(GDir) dir = NULL;
+  const char *dirname;
+
+  devfreq_dir = ppd_utils_get_sysfs_path (DEVFREQ_DIR);
+  dir = g_dir_open (devfreq_dir, 0, NULL);
+  if (!dir) {
+    g_debug ("Could not open %s: %s", devfreq_dir, g_strerror (errno));
+    return;
+  }
+
+  while ((dirname = g_dir_read_name (dir)) != NULL) {
+    g_autofree char *path = NULL;
+    PpdQcomDevfreq gpu = { 0, };
+
+    /* SM8650 exposes the Adreno devfreq device as 3d00000.gpu. Match the
+     * suffix so a different GPU node address still works. */
+    if (!g_str_has_suffix (dirname, ".gpu"))
+      continue;
+
+    path = g_build_filename (devfreq_dir, dirname, NULL);
+    if (!devfreq_init (path, &gpu, self->gpu_power_saver_percent))
+      continue;
+
+    self->gpu = gpu;
+    self->has_gpu = TRUE;
+    break;
+  }
+
+  if (!self->has_gpu)
+    g_debug ("No GPU devfreq device found, leaving the GPU clock alone");
+}
+
+static PpdProbeResult
+ppd_driver_qcom_cpufreq_probe (PpdDriver *driver)
+{
+  PpdDriverQcomCpufreq *self = PPD_DRIVER_QCOM_CPUFREQ (driver);
+  g_autoptr(GDir) dir = NULL;
+  g_autofree char *policy_dir = NULL;
+  const char *dirname;
+  int fd;
+
+  g_return_val_if_fail (self->policies == NULL, PPD_PROBE_RESULT_FAIL);
+
+  policy_dir = ppd_utils_get_sysfs_path (CPUFREQ_POLICY_DIR);
+  dir = g_dir_open (policy_dir, 0, NULL);
+  if (!dir) {
+    g_debug ("Could not open %s", policy_dir);
+    return PPD_PROBE_RESULT_FAIL;
+  }
+
+  self->cpu_power_saver_percent =
+    power_saver_percent ("PPD_QCOM_CPU_POWER_SAVER_PERCENT", POWER_SAVER_PERCENT);
+  self->gpu_power_saver_percent =
+    power_saver_percent ("PPD_QCOM_GPU_POWER_SAVER_PERCENT", GPU_POWER_SAVER_PERCENT);
+
+  self->policies = g_array_new (FALSE, FALSE, sizeof (PpdQcomPolicy));
+  g_array_set_clear_func (self->policies, (GDestroyNotify) policy_clear);
+
+  while ((dirname = g_dir_read_name (dir)) != NULL) {
+    g_autofree char *path = NULL;
+    PpdQcomPolicy policy = { 0, };
+
+    if (!g_str_has_prefix (dirname, "policy"))
+      continue;
+
+    path = g_build_filename (policy_dir, dirname, NULL);
+    if (!policy_init (path, &policy, self->cpu_power_saver_percent))
+      continue;
+
+    g_array_append_val (self->policies, policy);
+  }
+
+  if (self->policies->len == 0) {
+    g_debug ("No %s policies found", QCOM_SCALING_DRIVER);
+    return PPD_PROBE_RESULT_FAIL;
+  }
+
+  self->boost_path = ppd_utils_get_sysfs_path (CPUFREQ_BOOST_PATH);
+  fd = g_open (self->boost_path, O_WRONLY);
+  if (fd == -1) {
+    g_debug ("Could not open the cpufreq boost switch %s for writing: %s",
+             self->boost_path, g_strerror (errno));
+    return PPD_PROBE_RESULT_FAIL;
+  }
+  g_close (fd, NULL);
+
+  g_debug ("Found %u %s policies, boost switch at %s",
+           self->policies->len, QCOM_SCALING_DRIVER, self->boost_path);
+
+  gpu_probe (self);
+
+  return PPD_PROBE_RESULT_SUCCESS;
+}
+
+static gboolean
+apply_profile (PpdDriverQcomCpufreq *self,
+               PpdProfile             profile,
+               GError               **error)
+{
+  const char *boost_value;
+  guint i;
+
+  switch (profile) {
+  case PPD_PROFILE_POWER_SAVER:
+    boost_value = "0";
+    break;
+  case PPD_PROFILE_BALANCED:
+    boost_value = "0";
+    break;
+  case PPD_PROFILE_PERFORMANCE:
+    boost_value = "1";
+    break;
+  default:
+    g_return_val_if_reached (FALSE);
+  }
+
+  if (!ppd_utils_write (self->boost_path, boost_value, error))
+    return FALSE;
+
+  for (i = 0; i < self->policies->len; i++) {
+    PpdQcomPolicy *policy = &g_array_index (self->policies, PpdQcomPolicy, i);
+    g_autofree char *scaling_max_path = NULL;
+    g_autofree char *value = NULL;
+    guint max_freq;
+
+    switch (profile) {
+    case PPD_PROFILE_POWER_SAVER:
+      max_freq = policy->power_saver_max_freq;
+      break;
+    case PPD_PROFILE_PERFORMANCE:
+      max_freq = policy->boost_freq != 0 ? policy->boost_freq : policy->max_freq;
+      break;
+    case PPD_PROFILE_BALANCED:
+    default:
+      max_freq = policy->max_freq;
+      break;
+    }
+
+    scaling_max_path = g_build_filename (policy->path, "scaling_max_freq", NULL);
+    value = g_strdup_printf ("%u", max_freq);
+    if (!ppd_utils_write (scaling_max_path, value, error))
+      return FALSE;
+  }
+
+  if (self->has_gpu) {
+    g_autofree char *max_freq_path = NULL;
+    g_autofree char *value = NULL;
+    guint max_freq;
+
+    switch (profile) {
+    case PPD_PROFILE_POWER_SAVER:
+      max_freq = self->gpu.power_saver_max_freq;
+      break;
+    case PPD_PROFILE_BALANCED:
+    case PPD_PROFILE_PERFORMANCE:
+    default:
+      max_freq = self->gpu.max_freq;
+      break;
+    }
+
+    max_freq_path = g_build_filename (self->gpu.path, "max_freq", NULL);
+    value = g_strdup_printf ("%u", max_freq);
+    if (!ppd_utils_write (max_freq_path, value, error))
+      return FALSE;
+  }
+
+  return TRUE;
+}
+
+static gboolean
+ppd_driver_qcom_cpufreq_activate_profile (PpdDriver                   *driver,
+                                          PpdProfile                   profile,
+                                          PpdProfileActivationReason   reason,
+                                          GError                     **error)
+{
+  PpdDriverQcomCpufreq *self = PPD_DRIVER_QCOM_CPUFREQ (driver);
+
+  g_return_val_if_fail (self->boost_path != NULL, FALSE);
+
+  if (profile == PPD_PROFILE_UNSET)
+    return TRUE;
+
+  if (!apply_profile (self, profile, error)) {
+    if (self->activated_profile != PPD_PROFILE_UNSET) {
+      g_autoptr(GError) error_local = NULL;
+
+      if (!apply_profile (self, self->activated_profile, &error_local))
+        g_warning ("failed to restore previous profile: %s", error_local->message);
+    }
+    return FALSE;
+  }
+
+  self->activated_profile = profile;
+  return TRUE;
+}
+
+static void
+ppd_driver_qcom_cpufreq_finalize (GObject *object)
+{
+  PpdDriverQcomCpufreq *self = PPD_DRIVER_QCOM_CPUFREQ (object);
+
+  g_clear_pointer (&self->boost_path, g_free);
+  g_clear_pointer (&self->policies, g_array_unref);
+  g_clear_pointer (&self->gpu.path, g_free);
+
+  G_OBJECT_CLASS (ppd_driver_qcom_cpufreq_parent_class)->finalize (object);
+}
+
+static void
+ppd_driver_qcom_cpufreq_class_init (PpdDriverQcomCpufreqClass *klass)
+{
+  GObjectClass *object_class;
+  PpdDriverClass *driver_class;
+
+  object_class = G_OBJECT_CLASS (klass);
+  object_class->constructor = ppd_driver_qcom_cpufreq_constructor;
+  object_class->finalize = ppd_driver_qcom_cpufreq_finalize;
+
+  driver_class = PPD_DRIVER_CLASS (klass);
+  driver_class->probe = ppd_driver_qcom_cpufreq_probe;
+  driver_class->activate_profile = ppd_driver_qcom_cpufreq_activate_profile;
+}
+
+static void
+ppd_driver_qcom_cpufreq_init (PpdDriverQcomCpufreq *self)
+{
+  self->activated_profile = PPD_PROFILE_UNSET;
+}
