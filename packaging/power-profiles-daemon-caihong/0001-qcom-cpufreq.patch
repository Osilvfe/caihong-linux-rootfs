diff --git a/src/ppd-driver-qcom-cpufreq.c b/src/ppd-driver-qcom-cpufreq.c
new file mode 100644
index 0000000..76af7c4
--- /dev/null
+++ b/src/ppd-driver-qcom-cpufreq.c
@@ -0,0 +1,552 @@
+/*
