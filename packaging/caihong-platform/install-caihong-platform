#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu
CDPATH=

target_root=${CAIHONG_PLATFORM_ROOT:-/}
package=${1:-}
image_build=${CAIHONG_PLATFORM_IMAGE_BUILD:-0}

case $image_build in
	0|1) ;;
	*) echo "CAIHONG_PLATFORM_IMAGE_BUILD must be 0 or 1" >&2; exit 2 ;;
esac

if [ "$package" = --rollback ]; then
	component=${2:-}
	rollback_only=1
else
	rollback_only=0
fi

if [ "$rollback_only" -eq 0 ] &&
	{ [ -z "$package" ] || [ ! -f "$package" ] || [ ! -d "$target_root" ]; }; then
	echo "usage: $0 caihong-*.tar.zst" >&2
	echo "       $0 --rollback COMPONENT" >&2
	echo "CAIHONG_PLATFORM_ROOT may be set for offline installation" >&2
	exit 2
fi

for tool in awk bsdtar cat cp dirname find grep mkdir mktemp mv readlink rm rmdir sha256sum; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		echo "missing required tool: $tool" >&2
		exit 1
	fi
done

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/caihong-platform.XXXXXX") || exit 1

cleanup()
{
	rm -rf "$work_dir"
}
trap cleanup EXIT HUP INT TERM

target_root=$(cd -- "$target_root" && pwd)
if [ "$rollback_only" -eq 1 ]; then
	case $component in
		''|*[!A-Za-z0-9._-]*) echo "invalid component: ${component:-unset}" >&2; exit 2 ;;
	esac
	state=$target_root/var/lib/caihong-packages/$component
	[ -f "$state/installed-manifest" ] || {
		echo "no rollback manifest for component: $component" >&2
		exit 1
	}
	awk '{ a[NR] = $0 } END { for (record = NR; record >= 1; record--) print a[record] }' \
		"$state/installed-manifest" |
	while IFS=' ' read -r destination had_previous; do
		relative=${destination#"$target_root"/}
		previous="$state/previous/$relative"
		rm -rf -- "$destination"
		if [ "$had_previous" = yes ] && { [ -e "$previous" ] || [ -L "$previous" ]; }; then
			mkdir -p -- "$(dirname -- "$destination")"
			mv -- "$previous" "$destination"
		fi
	done
	rm -rf -- "$state"
	echo "rolled back Caihong component $component"
	parent_state=$target_root/var/lib/caihong-packages
	if [ -d "$parent_state" ]; then
		if [ -z "$(find "$parent_state" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
			rmdir -- "$parent_state"
		fi
	fi
	exit 0
fi

payload="$work_dir/payload"
installed="$work_dir/installed"
mkdir -p "$payload"
bsdtar -xf "$package" -C "$payload" manifest usr etc
if bsdtar -tf "$package" | grep -qx remove; then
	bsdtar -xf "$package" -C "$payload" remove
fi

architecture=$(cat "$payload/usr/share/caihong-package/architecture" 2>/dev/null || true)
component=$(cat "$payload/usr/share/caihong-package/package" 2>/dev/null || true)
version=$(cat "$payload/usr/share/caihong-package/version" 2>/dev/null || true)
if [ "$architecture" != aarch64 ] || [ -z "$component" ] || [ -z "$version" ]; then
	echo "invalid or missing Caihong package metadata" >&2
	exit 1
fi
case $component in
	*[!A-Za-z0-9._-]*) echo "invalid component: $component" >&2; exit 2 ;;
esac

(
	cd "$payload"
	while IFS='  ' read -r expected relative; do
		if [ -L "$relative" ]; then
			actual=$(readlink -- "$relative" | sha256sum | awk '{print $1}')
		else
			actual=$(sha256sum -- "$relative" | awk '{print $1}')
		fi
		if [ "$actual" != "$expected" ]; then
			echo "checksum mismatch: $relative" >&2
			exit 1
		fi
	done < manifest
)

state=$target_root/var/lib/caihong-packages/$component
mkdir -p "$state"
: > "$installed"

rollback()
{
	awk '{ a[NR] = $0 } END { for (record = NR; record >= 1; record--) print a[record] }' \
		"$installed" |
	while IFS=' ' read -r destination had_previous; do
		relative=${destination#"$target_root"/}
		previous="$state/previous/$relative"
		rm -rf -- "$destination"
		if [ "$had_previous" = yes ] && { [ -e "$previous" ] || [ -L "$previous" ]; }; then
			mkdir -p -- "$(dirname -- "$destination")"
			mv -- "$previous" "$destination"
		fi
	done
}

trap 'rollback; cleanup' HUP INT TERM

if [ -f "$payload/remove" ]; then
	while IFS= read -r path; do
		case $path in
			''|'#'*) continue ;;
			/*|../*|*/../*|*/..|*[![:print:]]*|*[[:space:]]*)
				echo "invalid removal path: $path" >&2
				rollback
				exit 1
				;;
			usr/*|etc/*) ;;
			*)
				echo "removal path must be below usr or etc: $path" >&2
				rollback
				exit 1
				;;
		esac
		case $path in
			usr/share/caihong-package/*) ;;
			*)
				if [ -e "$payload/$path" ] || [ -L "$payload/$path" ]; then
					echo "removal path is also present in payload: $path" >&2
					rollback
					exit 1
				fi
				;;
		esac
		destination=$target_root/$path
		relative=${destination#"$target_root"/}
		previous="$state/previous/$relative"
		mkdir -p -- "$(dirname -- "$previous")"
		rm -rf -- "$previous"
		had_previous=no
		if [ -e "$destination" ] || [ -L "$destination" ]; then
			mv -- "$destination" "$previous"
			had_previous=yes
		fi
		printf '%s %s\n' "$destination" "$had_previous" >> "$installed"
	done < "$payload/remove"
fi

while IFS= read -r entry; do
	path=${entry#./}
	case $path in
		usr/share/caihong-package/*) continue ;;
		etc/systemd/*)
			if [ "$image_build" = 1 ]; then
				destination=$target_root/$path
			else
				destination=$target_root/var/lib/caihong-config-pending/$component/$path
			fi
			;;
		etc/*)
			if [ "$image_build" = 1 ]; then
				destination=$target_root/$path
			else
				destination=$target_root/$path.caihong-new
			fi
			;;
		*) destination=$target_root/$path ;;
	esac
	relative=${destination#"$target_root"/}
	previous="$state/previous/$relative"

	mkdir -p -- "$(dirname -- "$destination")" "$(dirname -- "$previous")"
	rm -rf -- "$previous"
	had_previous=no
	if [ -e "$destination" ] || [ -L "$destination" ]; then
		mv -- "$destination" "$previous"
		had_previous=yes
	fi
	if ! mv -- "$payload/$path" "$destination"; then
		rollback
		cleanup
		exit 1
	fi
	printf '%s %s\n' "$destination" "$had_previous" >> "$installed"
done <<EOF
$(cd "$payload" && find ./usr ./etc -mindepth 1 \( -type f -o -type l \) -print | LC_ALL=C sort)
EOF

printf '%s\n' "$version" > "$state/version"
cp "$payload/manifest" "$state/manifest"
cp "$installed" "$state/installed-manifest"

trap - HUP INT TERM

# Existing Arch Linux ARM installations may still run SDDM.  The package
# carries PLM, but pacman does not enable it and does not remove SDDM by
# itself, so perform that migration explicitly after the payload is in place.
if [ "$image_build" = 0 ] && [ "$component" = caihong-platform ] && \
	[ -x "$target_root/usr/libexec/caihong-platform/switch-display-manager" ]; then
	CAIHONG_PLATFORM_ROOT="$target_root" \
	CAIHONG_PLATFORM_SKIP_DISPLAY_MANAGER="${CAIHONG_PLATFORM_SKIP_DISPLAY_MANAGER:-0}" \
	CAIHONG_PLATFORM_UPDATE_INSTALL=1 \
		"$target_root/usr/libexec/caihong-platform/switch-display-manager"
fi

cleanup

echo "installed Caihong component $component $version"
if [ "$image_build" = 0 ]; then
	echo "Systemd configuration candidates require manual review under /var/lib/caihong-config-pending/$component/etc/systemd."
	echo "New configuration files ending in .caihong-new require manual review."
fi
